# Disco Controller configuration. Copy to `.env` and adjust.
# `pnpm dev` loads `.env` from the repository root; in production pass these
# through systemd (EnvironmentFile=) or Docker Compose (env_file:).

# --- Runtime -----------------------------------------------------------------
# `production` enables secure cookies and refuses unsafe settings.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# --- Storage -----------------------------------------------------------------
# SQLite database file. The folder is created if missing. Back it up with
# Litestream (see docs/deployment.md).
DATABASE_PATH=./data/disco.db
# Built web app to serve. Defaults to apps/web/dist next to the server bundle.
# WEB_DIST_PATH=/opt/disco-controller/apps/web/dist
# Drizzle migrations folder. Defaults to apps/server/drizzle.
# MIGRATIONS_PATH=/opt/disco-controller/apps/server/drizzle

# --- Security ----------------------------------------------------------------
# Required in production, 32+ characters. Encrypts the stored Square access
# token and webhook key: changing it means reconnecting Square.
# Generate one with: openssl rand -base64 48
APP_SECRET=
# Password for the seeded admin user `kali` on first start. Leave blank to set
# it in the browser on first visit instead.
INITIAL_ADMIN_PASSWORD=
# Public URL customers use. Quote links, emails, and the Square webhook URL
# are built from it.
PUBLIC_BASE_URL=https://app.example.com
# Defaults to true when NODE_ENV=production. Set false only for plain-HTTP LAN testing.
# SECURE_COOKIES=true
# Sign-in sessions end after this much inactivity, and always after the absolute limit.
SESSION_IDLE_MINUTES=1440
SESSION_ABSOLUTE_HOURS=720

# --- Email -------------------------------------------------------------------
# SMTP connection URL, e.g. smtps://user:password@smtp.example.com:465
# Without it, emails are logged instead of sent.
SMTP_URL=
MAIL_FROM="Undercover Dance Party <bookings@example.com>"

# --- Background jobs ---------------------------------------------------------
# Runs email delivery, Square invoicing, reconciliation, and overdue checks.
SCHEDULER_ENABLED=true

# --- Public quote request form -----------------------------------------------
# Submissions allowed per client IP within the window.
QUOTE_REQUEST_RATE_LIMIT=5
QUOTE_REQUEST_RATE_WINDOW_MINUTES=60

# --- Square ------------------------------------------------------------------
# Square credentials are entered in Settings → Square, not here.
# `mock` uses an in-memory fake for development and tests (refused in production).
SQUARE_MODE=live
# How often open invoices are re-checked in case a webhook was missed.
SQUARE_RECONCILE_MINUTES=15

# --- Backups (Litestream → Backblaze B2) -------------------------------------
# Read by deploy/litestream.yml. See docs/deployment.md.
DISCO_DB_PATH=/var/lib/disco-controller/disco.db
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=s3.us-west-004.backblazeb2.com
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
